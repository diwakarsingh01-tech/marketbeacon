# MarketBeacon Environment Configuration

# --- Google OAuth Setup ---
# 1. Go to https://console.cloud.google.com/
# 2. Create a project and "OAuth Client ID" (Web Application)
# 3. Add http://localhost:5173 to "Authorized JavaScript origins"
# 4. Copy the Client ID below

VITE_GOOGLE_CLIENT_ID=500460562927-5b1mt1r0vcke4u3mm5hhj1a4cmilsgao.apps.googleusercontent.com
GOOGLE_CLIENT_ID=500460562927-5b1mt1r0vcke4u3mm5hhj1a4cmilsgao.apps.googleusercontent.com

# --- SEO & Analytics ---
# Get your GA4 Measurement ID:
#   https://analytics.google.com → Admin → Data Streams → Web → copy ID
# Then uncomment and set:
# VITE_GA_ID=G-XXXXXXXXXX

# Get your Google Search Console verification token:
#   https://search.google.com/search-console → Add property → "HTML tag" method
# Then uncomment and set:
# VITE_GSC_VERIFICATION=YOUR_VERIFICATION_TOKEN_HERE

# Meta/Facebook Pixel ID (optional):
#   https://business.facebook.com → Events Manager → Pixels
# Then uncomment and set:
# VITE_META_PIXEL_ID=000000000000000

# --- AI (DeepSeek API) ---
# 1. Go to https://platform.deepseek.com/ and create an account
# 2. Top up balance (prepaid — API is metered, no free tier; deepseek-chat is very cheap, ~$0.27/1M tokens)
# 3. API Keys -> Create new key -> copy it below
# Optional: DEEPSEEK_MODEL=deepseek-chat  (V3, default) or deepseek-reasoner (R1, slower/costlier)
DEEPSEEK_API_KEY=

# --- Database ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Auth ---
JWT_SECRET=marketbeacon-super-secret-key-2026

# --- n8n Integration (required for /api/n8n/* + n8n workflows) ---
# Generate with: openssl rand -hex 24
# IMPORTANT: Same value must reach BOTH containers on VPS (docker-compose
# passes N8N_API_KEY to marketbeacon-backend AND n8n). Backend fails closed
# (403) if this is unset — no hardcoded fallback anymore.
N8N_API_KEY=

# --- n8n workflows ---
# Base URL n8n workflows use to reach the backend:
#   Docker (VPS): http://mb-backend:3001
#   Local n8n:    http://localhost:3001
MB_API_URL=http://mb-backend:3001

# Telegram bot token for n8n Telegram workflows (BotFather).
# Hardcoded tokens were removed from workflow files (public-repo leak) —
# put the token here only. If the old token was ever committed, rotate it.
TELEGRAM_BOT_TOKEN=
