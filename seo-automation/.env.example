# MarketBeaconPro SEO Automation Environment Variables

# WordPress CLI Configuration
WP_CLI_AUTH_TOKEN=your_wp_cli_auth_token_here
WP_CLI_URL=https://your-wordpress-site.com

# SendGrid API Key (for outreach automation)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Internal LLM Endpoint (for content expansion)
LLM_ENDPOINT=https://your-llm-endpoint.com/v1/generate
LLM_API_KEY=your_llm_api_key_here

# Optional: Database connection (if needed)
DATABASE_URL=sqlite:///./data/app.db

# Optional: Logging configuration
LOG_LEVEL=INFO
LOG_FILE=logs/seo-automation.log

# Optional: Cache configuration
CACHE_DIR=./cache
CACHE_EXPIRY=86400

# Optional: Monitoring
MONITORING_ENABLED=true
MONITORING_ENDPOINT=https://your-monitoring-endpoint.com
