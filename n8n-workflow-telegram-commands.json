[
    {
        "id": "tgBotResponder2026",
        "name": "Telegram Bot Command Responder",
        "active": false,
        "nodes": [
            {
                "parameters": {
                    "updates": [
                        "message"
                    ]
                },
                "id": "tg-trigger",
                "name": "Telegram Trigger",
                "type": "n8n-nodes-base.telegramTrigger",
                "typeVersion": 1.1,
                "position": [
                    100,
                    200
                ],
                "credentials": {
                    "telegramApi": {
                        "id": "tg-creds-mb",
                        "name": "Telegram Bot API Creds"
                    }
                }
            },
            {
                "parameters": {
                    "jsCode": "const input = $input.first().json;\nconst text = input.message?.text || '';\nconst chatId = input.message?.chat?.id;\nconst username = input.message?.from?.first_name || 'Trader';\n\nconst parts = text.trim().split(/\\s+/);\nconst command = parts[0].toLowerCase();\nlet symbol = parts[1] || '';\n\nlet valid = false;\nif (command.startsWith('/audit') || command.startsWith('/momentum')) {\n  symbol = symbol.trim().toUpperCase().replace('.NS', '');\n  if (symbol.length > 0) {\n    valid = true;\n  }\n}\n\nreturn [{ json: { symbol, chatId, username, valid } }];"
                },
                "id": "parse-command",
                "name": "Parse Command",
                "type": "n8n-nodes-base.code",
                "typeVersion": 2,
                "position": [
                    320,
                    200
                ]
            },
            {
                "parameters": {
                    "conditions": {
                        "options": {
                            "caseSensitive": true,
                            "leftValue": "",
                            "type": "mix"
                        },
                        "conditions": [
                            {
                                "id": "val-check",
                                "leftValue": "={{ $json.valid }}",
                                "comparison": "true",
                                "rightValue": ""
                            }
                        ],
                        "combinator": "and"
                    }
                },
                "id": "if-valid",
                "name": "If Valid",
                "type": "n8n-nodes-base.if",
                "typeVersion": 2.2,
                "position": [
                    540,
                    200
                ]
            },
            {
                "parameters": {
                    "url": "=http://mb-backend:3001/api/public/analysis/{{ $json.symbol }}",
                    "options": {
                        "ignoreHttpStatusErrors": true
                    }
                },
                "id": "get-analysis",
                "name": "Get Analysis",
                "type": "n8n-nodes-base.httpRequest",
                "typeVersion": 4.2,
                "position": [
                    760,
                    100
                ]
            },
            {
                "parameters": {
                    "jsCode": "const response = $('Get Analysis').first().json;\nconst parsed = $('Parse Command').first().json;\nconst symbol = parsed.symbol;\n\nlet message = '';\nif (response.error) {\n  message = `❌ *Stock symbol not found.*\\nCould not retrieve analysis for *${symbol}*. Please verify the NSE/BSE ticker name (e.g. INFY, RELIANCE, TCS).`;\n} else {\n  const score = Math.round(response.score || 0);\n  const smartMoney = (response.smartMoney || 0).toFixed(1);\n  const upside = response.upside || 0;\n  const isPass = response.isPass ? '🟢 PASSED AUDIT' : '🔴 AUDIT FAILED';\n  \n  let level = 'HOLD';\n  if (score >= 85) level = 'Strong Buy / Max Confidence';\n  else if (score >= 70) level = 'Safe Accumulation';\n  else if (score >= 45) level = 'Hold / Monitor';\n  else level = 'High Risk / Take Profit';\n\n  message = `🛡️ *MarketBeacon Pro: Institutional Audit*\\n`;\n  message += `━━━━━━━━━━━━━━━━━━━━━━━━━━\\n`;\n  message += `📊 *Asset*: *${symbol}*\\n`;\n  message += `💰 *Current Price*: ₹${Math.round(response.quotes?.[response.quotes.length - 1]?.close || 0)}\\n\\n`;\n  message += `📈 *Audit Score*: *${score}/100* (${level})\\n`;\n  message += `🎯 *Model Target*: +${upside}% (${isPass})\\n`;\n  message += `💼 *Smart Money Ownership*: *${smartMoney}%*\\n\\n`;\n  message += `📌 *ABCD Strategy Tranches*: [Locked 🔒]\\n`;\n  message += `🔑 *Upgrade / Unlock Detailed Entry Levels*:\\n`;\n  message += `👉 [marketbeaconpro.com/check?symbol=${symbol}](https://marketbeaconpro.com/check?symbol=${symbol})\\n`;\n  message += `━━━━━━━━━━━━━━━━━━━━━━━━━━`;\n}\n\nreturn [{ json: { message, chatId: parsed.chatId } }];"
                },
                "id": "format-reply",
                "name": "Format Reply",
                "type": "n8n-nodes-base.code",
                "typeVersion": 2,
                "position": [
                    980,
                    100
                ]
            },
            {
                "parameters": {
                    "method": "POST",
                    "url": "https://api.telegram.org/bot8655611972:AAGpD3ctlNziHyngc8ov5MSVlggYl5Qg7UM/sendMessage",
                    "sendBody": true,
                    "specifyBody": "json",
                    "jsonBody": "={\n  \"chat_id\": \"{{ $json.chatId }}\",\n  \"text\": {{ JSON.stringify($json.message) }},\n  \"parse_mode\": \"Markdown\"\n}",
                    "options": {}
                },
                "id": "send-reply",
                "name": "Send Reply",
                "type": "n8n-nodes-base.httpRequest",
                "typeVersion": 4.2,
                "position": [
                    1200,
                    100
                ]
            },
            {
                "parameters": {
                    "method": "POST",
                    "url": "https://api.telegram.org/bot8655611972:AAGpD3ctlNziHyngc8ov5MSVlggYl5Qg7UM/sendMessage",
                    "sendBody": true,
                    "specifyBody": "json",
                    "jsonBody": "={\n  \"chat_id\": \"{{ $json.chatId }}\",\n  \"text\": \"⚠️ *Usage*: Use /audit <ticker> (e.g. \\`/audit INFY\\` or \\`/momentum RELIANCE\\`) to retrieve the fundamental score.\",\n  \"parse_mode\": \"Markdown\"\n}",
                    "options": {}
                },
                "id": "send-usage",
                "name": "Send Usage",
                "type": "n8n-nodes-base.httpRequest",
                "typeVersion": 4.2,
                "position": [
                    760,
                    300
                ]
            }
        ],
        "connections": {
